# --- Database (PostgreSQL) ---
   DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-floral-wave-b55jz104-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require
# Set to "true" for managed Postgres that requires TLS (Neon, Render, Railway...)
   PGSSL=true

# --- Auth ---
# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string

# --- AI (server-side only; never exposed to the browser) ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
AI_MODEL=gemini-3.6-flash
# Per-call timeout in ms before we give up and fall back to manual mode
AI_TIMEOUT_MS=15000
